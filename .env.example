# Mật khẩu tài khoản sa của SQL Server (bắt buộc >= 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt)
SA_PASSWORD=MiniMart@2026!

# Thay bằng IP VPS hoặc tên miền thật của bạn, ví dụ: http://123.45.67.89:8080 hoặc https://minimart.yourdomain.com
PUBLIC_BASE_URL=http://localhost:8080

# (Tùy chọn) Nếu dùng đăng nhập Google OAuth2
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
